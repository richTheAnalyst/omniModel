# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google Places ---
GOOGLE_PLACES_API_KEY=

# --- Ollama (local LLM, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=120.0

# --- OpenRouter (model aggregator, cheap, many models) ---
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Extraction backend selection ---
# "ollama" (default, free) | "openrouter" (cheap, many models)
# | "claude" (paid, high quality)
EXTRACTION_BACKEND=openrouter

# --- Playwright ---
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# --- HTTP / requests ---
HTTP_TIMEOUT_S=30.0
HTTP_USER_AGENT=omniModel/0.1 (+https://omnimodel.example)

# --- Misc ---
LOG_LEVEL=INFO

# --- Legacy FastAPI worker (main.py only) ---
# Shared secret that Laravel sends as the X-API-Key header.
SERVICE_API_KEY=

# --- REST API (omnimodel/api/main.py only) ---
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173